# Public client credentials from Supabase → Project Settings → API.
# Never put a database password, service-role key, or sb_secret_ key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# live is the default when both values above exist. Use demo explicitly to
# keep testing with the original fictional profiles without touching the DB.
EXPO_PUBLIC_APP_MODE=live

# RevenueCat PUBLIC platform SDK keys. Real checkout requires a native build.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Publish your own HTTPS legal pages before enabling checkout.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
