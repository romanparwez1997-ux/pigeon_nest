{
  "expo": {
    "name": "Pigeon Post",
    "slug": "pigeon-post",
    "version": "1.0.0",
    "scheme": "pigeonpost",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.romanparwez.pigeonpost",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "com.romanparwez.pigeonpost",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAdaptiveAndroid",
      "expo-sharing",
      "expo-notifications",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Pigeon Post to use your camera for video calls you choose to join.",
          "microphonePermission": "Allow Pigeon Post to use your microphone for calls you choose to join."
        }
      ]
    ]
  }
}
